<?xml version="1.0" encoding="utf-8"?>
<!-- Dark theme palette — the app's original (and default) look. The
     light palette lives in values/themes.xml; the active one is picked
     by AppCompatDelegate night mode (see EqApp + the Settings toggle). -->
<resources>
    <style name="Theme.Equalizer314" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- AutoVybz: Jamaica accents on charcoal (see values/autovybz_colors.xml). -->
        <item name="colorPrimary">@color/avz_green</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">@color/avz_green_container</item>
        <item name="colorOnPrimaryContainer">#FFC8F5D8</item>

        <!-- Secondary: gold -->
        <item name="colorSecondary">@color/avz_gold</item>
        <item name="colorOnSecondary">#FF121212</item>
        <item name="colorSecondaryContainer">@color/avz_gold_container</item>
        <item name="colorOnSecondaryContainer">#FFFFF1B3</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/avz_green_bright</item>
        <item name="colorOnTertiary">#FF00210C</item>
        <item name="colorTertiaryContainer">@color/avz_green_container</item>
        <item name="colorOnTertiaryContainer">#FFC8F5D8</item>

        <!-- Surface / background -->
        <item name="android:colorBackground">@color/avz_background</item>
        <item name="android:windowBackground">@color/avz_background</item>
        <item name="colorSurface">@color/avz_background</item>
        <item name="colorOnSurface">@color/avz_on_dark</item>
        <item name="colorSurfaceVariant">#FF1E1E1E</item>
        <item name="colorOnSurfaceVariant">@color/avz_on_dark_muted</item>
        <item name="colorSurfaceContainerLow">@color/avz_surface</item>
        <item name="colorSurfaceContainer">#FF1C1C1C</item>
        <item name="colorSurfaceContainerHigh">@color/avz_surface_high</item>

        <!-- Outline -->
        <item name="colorOutline">@color/avz_outline</item>
        <item name="colorOutlineVariant">#FF2C2C2C</item>
        <item name="colorError">@color/avz_error</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
